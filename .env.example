APP_NAME="Bunat Fabrics"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bunat_fabrics
DB_USER=bunat_user
DB_PASS=change-me
DB_CHARSET=utf8mb4

ADMIN_NAME="Site Admin"
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=Admin@123

# Account email: disabled by default; file is allowed only outside production.
MAIL_DRIVER=disabled
MAIL_FROM_ADDRESS=accounts@example.test
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=

# Local OAuth: set APP_URL=http://localhost and browse only that origin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/auth/google/callback
